---
interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = '/img/logos/logo.webp' } = Astro.props;

// Genera la URL canónica automáticamente
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://dramartaapodaca.com');
const fullImageURL = new URL(image, Astro.site || 'https://dramartaapodaca.com');
---

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageURL} />
<meta property="og:locale" content="es_PY" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={fullImageURL} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Schema.org para Google -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Dentist",
  "name": "Dra. Marta Apodaca - Odontología",
  "image": fullImageURL.toString(),
  "url": "https://dramartaapodaca.com",
  "telephone": "+595972762266",
  "priceRange": "$$",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Tu dirección exacta",
    "addressLocality": "Salvador del Mundo 530",
    "addressRegion": "Asunción",
    "postalCode": "001524",
    "addressCountry": "PY"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -25.273843685268456,
    "longitude": -57.54911238649437
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  ],
})} />