---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

const {
	title = "Odontología - Dra. Marta Apodaca",
	description = "Consultorio dental profesional con atención personalizada.",
	image = "/img/logos/logo.webp",
	url = "https://dramartaapodaca.com",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/webp" href="/img/logos/logo.webp" />
		<SEO {title} {description} {image} {url} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		transition: background-color 0.5s ease;
	}
	body.blackout {
		background-color: #000000 !important;
	}
	body.blackout * {
		color: #000000 !important;
		background-color: #000000 !important;
		border-color: #000000 !important;
	}
</style>
