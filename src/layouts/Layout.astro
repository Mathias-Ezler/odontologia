---
import '../styles/global.css';
import SEO from '../components/SEO.astro';

const {
	title = "Dentista en Encarnación - Dra. Marta Apodaca | Odontología Profesional",
	description = "Clínica dental en Encarnación, Paraguay. Ortodoncia, limpieza dental, blanqueamiento y más. 📍 Agenda tu cita. ⭐ 15 años de experiencia.",
	image = "/img/logos/logo.webp",
} = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		
		<!-- Favicons -->
		<link rel="icon" type="image/webp" href="/img/logos/logo.webp" />
		<link rel="apple-touch-icon" href="/img/logos/logo.webp" />
		
		<!-- Preconnect para mejorar performance -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		
		<!-- SEO Component -->
		<SEO {title} {description} {image} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	html {
		scroll-behavior: smooth;
	}
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		transition: background-color 0.5s ease;
	}
	body.blackout {
		background-color: #000000 !important;
	}
	body.blackout * {
		color: #000000 !important;
		background-color: #000000 !important;
		border-color: #000000 !important;
	}
</style>